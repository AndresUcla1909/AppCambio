# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca se sube a git.

# --- Supabase: historial en línea (lectura desde el navegador) -------------
# Project Settings → API Keys. La publishable key (sb_publishable_…) es
# pública por diseño: RLS sólo le permite leer.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Captura diaria /api/cron/bcv (sólo servidor) ---------------------------
# Nunca con prefijo NEXT_PUBLIC_: llegaría al navegador.
# Secret key de Supabase (sb_secret_…): se salta RLS para escribir tasas_bcv.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Contraseña del endpoint. Vercel Cron la manda sola como
# "Authorization: Bearer <CRON_SECRET>". Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
